#!/usr/bin/env bash
set -euo pipefail

# BaseAcpAgent uploads the host agent-acp binary into this in-container staging
# path by calling Harbor environment.upload_file(...). This is a copied file
# inside the container, not a bind mount and not the original host binary.
install -Dm755 "{{ staged_backend_path }}" /usr/local/bin/agent-acp

install -d "{{ agent_home }}"

# HarborAcpAgent optionally uploads the host credential directory through
# Harbor environment.upload_dir(...). The staged directory is an in-container
# copy used to populate a fresh AGENT_HOME for the run.
if [[ -d "{{ staged_credentials_dir }}" ]]; then
  rm -rf "{{ agent_home }}/credentials"
  cp -R "{{ staged_credentials_dir }}" "{{ agent_home }}/credentials"
fi

# HarborAcpAgent uploads host config.toml, when present, through Harbor
# environment.upload_file(...). The staged file is a copied in-container file,
# not a live host path.
if [[ -f "{{ staged_config_path }}" ]]; then
  install -Dm644 "{{ staged_config_path }}" "{{ agent_home }}/config.toml"
fi

test -x /usr/local/bin/agent-acp
